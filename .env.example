# Database
DATABASE_URL=postgresql+asyncpg://app:changeme@localhost:5432/novel_translator

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=replace-with-random-32-char-string

# Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_SOURCE=novel-source
STORAGE_BUCKET_OUTPUT=novel-output
STORAGE_PRESIGNED_EXPIRY_SECONDS=3600
STORAGE_REGION=us-east-1

# File limits
MAX_FILE_SIZE_MB=50
CHUNK_SIZE_CHARS=2000

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
